# Package

version       = "0.1.0"
author        = "George Lemon"
description   = "Pure-Nim audio encoders/decoders: PCM, ADPCM, FLAC, Vorbis, MP3, AAC, ALAC (Symphonia port + encoders)"
license       = "MPL-2.0"
srcDir        = "src"


# Dependencies

requires "nim >= 2.4.0"
requires "buffalo >= 0.1.0"
requires "nimsimd >= 1.3.2"
