# Package

version       = "0.1.0"
author        = "George Lemon"
description   = "Pure Nim audio encoders and decoders: WAV, FLAC, Vorbis, MP3, AAC, ALAC, AIFF, CAF"
license       = "MPL-2.0"
srcDir        = "src"


# Dependencies

requires "nim >= 2.4.0"
requires "buffalo >= 0.1.0"
requires "nimsimd >= 1.3.2"
